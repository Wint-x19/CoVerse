{
  "name": "coverse",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": { "node": ">=20.19.0", "pnpm": ">=10 <11" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx tools/smoke.ts",
    "check": "pnpm build && pnpm typecheck && pnpm test && pnpm fixtures:check && pnpm smoke && node tools/m31/offline.mjs",
    "eval:m31:offline": "vitest run tools/m31 packages/protocols/test packages/adapters packages/cli/test/run-cli.test.ts packages/drivers/test && node tools/m31/offline.mjs",
    "eval:m31:live": "node tools/m31/live.mjs",
    "fixtures:collect": "tsx tools/fixtures/cli.ts",
    "fixtures:check": "tsx tools/fixtures/check-cli.ts",
    "coverse": "node packages/cli/dist/bin.js",
    "ui": "pnpm --filter @coverse/ui start",
    "ui:dev": "pnpm --filter @coverse/ui dev",
    "ui:pack": "pnpm --filter @coverse/ui pack",
    "ui:dist": "pnpm --filter @coverse/ui dist"
  },
  "devDependencies": {
    "@coverse/core": "workspace:*",
    "@coverse/protocols": "workspace:*",
    "@types/node": "22.19.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
