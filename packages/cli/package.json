{
  "name": "@coverse/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "coverse": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@coverse/core": "workspace:*",
    "@coverse/protocols": "workspace:*",
    "@coverse/adapter-codex": "workspace:*",
    "@coverse/adapter-claude-code": "workspace:*",
    "@coverse/adapter-antigravity": "workspace:*"
  }
}
